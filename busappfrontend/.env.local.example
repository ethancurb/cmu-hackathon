# Copy to .env.local and fill in. .env.local is gitignored; this example file is not.

# MongoDB Atlas M0 connection string, including the database name.
# Atlas > Cluster > Connect > Drivers. Never commit the filled-in value.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/loadline?retryWrites=true&w=majority

# Which CapacitySource the factory returns.
#   mock   MockMemorySource — the fixture read in process. No database, no network.
#          THIS IS THE DEMO PATH. Leave it set to mock unless you are testing Mongo.
#   mongo  MockMongoSource  — the same fixture read out of Atlas (ADR-0001 time-series).
#          Requires MONGODB_URI and a seeded cluster.
#   live   PRTLiveSource    — documented no-op stub, returns empty results.
#   hybrid not implemented; the factory throws at startup.
DATA_MODE=mock
